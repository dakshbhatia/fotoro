{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fotoro.cloud/contracts/v1",
  "$defs": {
    "AccountCardV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "accountId",
        "boxPublicKey",
        "signingPublicKey"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "boxPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "signingPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        }
      }
    },
    "MediaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "photoId",
        "representationId",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "representationId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "thumbnail",
            "preview",
            "original",
            "metadata"
          ]
        }
      }
    },
    "RepresentationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "objectId",
        "header",
        "ciphertextBytes",
        "ciphertextSha256"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/MediaBinding"
        },
        "objectId": {
          "type": "string",
          "format": "uuid"
        },
        "header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 32,
          "maxLength": 32
        },
        "ciphertextBytes": {
          "type": "integer",
          "minimum": 45
        },
        "ciphertextSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        }
      }
    },
    "PhotoMetadataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "filename",
        "mediaType",
        "sourceDate",
        "dateSource",
        "originalBytes",
        "originalSha256",
        "representationKeys"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mediaType": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/heic",
            "video/mp4",
            "video/quicktime",
            "application/vnd.fotoro.live-photo"
          ]
        },
        "sourceDate": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "dateSource": {
          "enum": [
            "exif",
            "photos",
            "import"
          ]
        },
        "originalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "originalSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "representationKeys": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "uuid"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$",
            "minLength": 43,
            "maxLength": 43
          }
        }
      }
    },
    "WrappedKeyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "nonce",
        "ciphertext"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 32,
          "maxLength": 32
        },
        "ciphertext": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        }
      }
    },
    "PhotoManifestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "photoId",
        "ownerAccountId",
        "representations",
        "metadataRepresentation",
        "ownerWrappedMetadataKey"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/RepresentationV1"
          }
        },
        "metadataRepresentation": {
          "$ref": "#/$defs/RepresentationV1"
        },
        "ownerWrappedMetadataKey": {
          "$ref": "#/$defs/WrappedKeyV1"
        }
      }
    },
    "SignedPayloadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "accountId",
        "body",
        "signature"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 86,
          "maxLength": 86
        }
      }
    },
    "UploadReservationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "uploadId",
        "photoId",
        "representationId",
        "stagingUrl",
        "expiresAt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "uploadId": {
          "type": "string",
          "format": "uuid"
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "representationId": {
          "type": "string",
          "format": "uuid"
        },
        "stagingUrl": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "UploadCommitV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "uploadId",
        "objectId",
        "ciphertextBytes",
        "ciphertextSha256"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "uploadId": {
          "type": "string",
          "format": "uuid"
        },
        "objectId": {
          "type": "string",
          "format": "uuid"
        },
        "ciphertextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "ciphertextSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        }
      }
    },
    "GrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId",
        "momentId",
        "ownerAccountId",
        "recipientAccountId",
        "role",
        "expiresAt",
        "revokedAt",
        "version"
      ],
      "properties": {
        "grantId": {
          "type": "string",
          "format": "uuid"
        },
        "momentId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "enum": [
            "viewer",
            "contributor"
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revokedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ShareBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grantId",
        "photoId",
        "senderAccountId",
        "recipientAccountId"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grantId": {
          "type": "string",
          "format": "uuid"
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "senderAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientAccountId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ShareKeyEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grantId",
        "photoId",
        "senderAccountId",
        "recipientAccountId",
        "sealedMetadataKey",
        "senderSignature"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grantId": {
          "type": "string",
          "format": "uuid"
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "senderAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "recipientAccountId": {
          "type": "string",
          "format": "uuid"
        },
        "sealedMetadataKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 107,
          "maxLength": 107
        },
        "senderSignature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 86,
          "maxLength": 86
        }
      }
    },
    "SavedPhotoV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationId",
        "photoId",
        "sourceGrantId",
        "sourcePhotoId",
        "manifest",
        "signedPayload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "photoId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceGrantId": {
          "type": "string",
          "format": "uuid"
        },
        "sourcePhotoId": {
          "type": "string",
          "format": "uuid"
        },
        "manifest": {
          "$ref": "#/$defs/PhotoManifestV1"
        },
        "signedPayload": {
          "$ref": "#/$defs/SignedPayloadV1"
        }
      }
    },
    "ChangeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "entity",
        "entityId",
        "deleted",
        "payload"
      ],
      "properties": {
        "cursor": {
          "type": "string"
        },
        "entity": {
          "enum": [
            "photo",
            "grant",
            "annotation"
          ]
        },
        "entityId": {
          "type": "string",
          "format": "uuid"
        },
        "deleted": {
          "type": "boolean"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedPayloadV1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ChangePageV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "changes",
        "nextCursor",
        "hasMore"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "changes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ChangeV1"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasMore": {
          "type": "boolean"
        },
        "mediaVersion": {
          "const": 1
        }
      }
    },
    "ApiErrorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "code",
        "retryable",
        "requestId"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "code": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ReserveUploadV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "binding",
        "ciphertextBytes",
        "ciphertextSha256",
        "operationId"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "binding": {
          "$ref": "#/$defs/MediaBinding"
        },
        "ciphertextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "ciphertextSha256": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "VaultWrapperV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "wrapperId",
        "kind",
        "credentialId",
        "prfSalt",
        "wrappedBundle",
        "verified"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "wrapperId": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "recovery",
            "prf",
            "device"
          ]
        },
        "credentialId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prfSalt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$",
              "minLength": 43,
              "maxLength": 43
            },
            {
              "type": "null"
            }
          ]
        },
        "wrappedBundle": {
          "$ref": "#/$defs/WrappedKeyV1"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "VaultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "accountCard",
        "wrappers"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "accountCard": {
          "$ref": "#/$defs/AccountCardV1"
        },
        "wrappers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VaultWrapperV1"
          }
        }
      }
    },
    "EnrollDeviceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "deviceId",
        "boxPublicKey",
        "origin"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "boxPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "origin": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "DeviceChallengeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "deviceId",
        "boxPublicKey",
        "origin",
        "enrollmentId",
        "accountId",
        "challenge",
        "expiresAt",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "boxPublicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "enrollmentId": {
          "type": "string",
          "format": "uuid"
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "challenge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "minLength": 43,
          "maxLength": 43
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "completed"
          ]
        }
      }
    },
    "DeviceApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "signedPayload",
        "sealedBundle"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "signedPayload": {
          "$ref": "#/$defs/SignedPayloadV1"
        },
        "sealedBundle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        }
      }
    },
    "CreateGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grant",
        "envelopes",
        "signedPayload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grant": {
          "$ref": "#/$defs/GrantV1"
        },
        "envelopes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ShareKeyEnvelopeV1"
          }
        },
        "signedPayload": {
          "$ref": "#/$defs/SignedPayloadV1"
        }
      }
    },
    "ContributionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationId",
        "expectedGrantVersion",
        "manifests",
        "envelopes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedGrantVersion": {
          "type": "integer",
          "minimum": 1
        },
        "manifests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SignedPayloadV1"
          }
        },
        "envelopes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ShareKeyEnvelopeV1"
          }
        }
      }
    },
    "SaveRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "expectedGrantVersion",
        "save"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "expectedGrantVersion": {
          "type": "integer",
          "minimum": 1
        },
        "save": {
          "$ref": "#/$defs/SavedPhotoV1"
        }
      }
    },
    "SessionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "accountId",
        "deviceId",
        "expiresAt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "deviceId": {
          "type": "string",
          "format": "uuid"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "token": {
          "type": "string"
        }
      }
    },
    "AccountEnrollmentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "accountCard",
        "recoveryWrapper",
        "proof"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "accountCard": {
          "$ref": "#/$defs/AccountCardV1"
        },
        "recoveryWrapper": {
          "$ref": "#/$defs/VaultWrapperV1"
        },
        "proof": {
          "$ref": "#/$defs/SignedPayloadV1"
        }
      }
    },
    "GrantInboxV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grants"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GrantV1"
          }
        }
      }
    },
    "GrantDetailV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "grant",
        "envelopes",
        "manifests",
        "cards"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "grant": {
          "$ref": "#/$defs/GrantV1"
        },
        "envelopes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ShareKeyEnvelopeV1"
          }
        },
        "manifests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/SignedPayloadV1"
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountCardV1"
          }
        }
      }
    },
    "AuthOptionsRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "client"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "client": {
          "enum": [
            "web",
            "native"
          ]
        }
      }
    },
    "AuthVerifyRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "challengeId",
        "response",
        "client"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "challengeId": {
          "type": "string",
          "format": "uuid"
        },
        "response": {
          "type": "object"
        },
        "client": {
